{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Training starten / fortsetzen (Second Edition, Dauerbetrieb)",
      "type": "process",
      "command": "${workspaceFolder:python}/.venv/bin/python",
      "args": [
        "-u",
        "${workspaceFolder:python}/scripts/train_decision_ppo.py",
        "--continuous",
        "--auto-resume",
        "--workers",
        "4",
        "--eval-every-games",
        "5000",
        "--seed",
        "331",
        "--engine",
        "${workspaceFolder:python}/../build/7Wonders",
        "--output-dir",
        "${workspaceFolder:python}/runs/continuous-decision-pfsp-v1-seed331"
      ],
      "options": {
        "cwd": "${workspaceFolder:python}"
      },
      "problemMatcher": [],
      "runOptions": {
        "instanceLimit": 1
      },
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "clear": false
      }
    },
    {
      "label": "Training sauber stoppen (Second Edition, nach aktuellem Update)",
      "type": "process",
      "command": "${workspaceFolder:python}/.venv/bin/python",
      "args": [
        "${workspaceFolder:python}/scripts/train_decision_ppo.py",
        "--stop",
        "--output-dir",
        "${workspaceFolder:python}/runs/continuous-decision-pfsp-v1-seed331"
      ],
      "options": {
        "cwd": "${workspaceFolder:python}"
      },
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "dedicated"
      }
    },
    {
      "label": "Aktuellen Snapshot separat evaluieren (Second Edition)",
      "type": "process",
      "command": "${workspaceFolder:python}/.venv/bin/python",
      "args": [
        "-u",
        "${workspaceFolder:python}/scripts/eval_decision.py",
        "--workers",
        "4",
        "--run-dir",
        "${workspaceFolder:python}/runs/continuous-decision-pfsp-v1-seed331",
        "--engine",
        "${workspaceFolder:python}/../build/7Wonders"
      ],
      "options": {
        "cwd": "${workspaceFolder:python}"
      },
      "problemMatcher": [],
      "runOptions": {
        "instanceLimit": 1
      },
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "clear": false
      }
    },
    {
      "label": "Analyse-Dashboard im Browser öffnen",
      "type": "process",
      "command": "${workspaceFolder:python}/.venv/bin/python",
      "args": [
        "${workspaceFolder:python}/scripts/open_dashboard.py",
        "--run-dir",
        "runs/continuous-decision-pfsp-v1-seed331"
      ],
      "options": {
        "cwd": "${workspaceFolder:python}"
      },
      "problemMatcher": [],
      "presentation": {
        "reveal": "silent",
        "panel": "dedicated"
      }
    }
  ]
}
